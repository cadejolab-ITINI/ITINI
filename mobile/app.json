{
  "expo": {
    "name": "ITINI",
    "slug": "itini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "itini",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07111F",
    "ios": {
      "bundleIdentifier": "ni.itini.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ITINI usa tu ubicación para mostrarte en el mapa y preparar una alerta SOS de demostración."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/brand/adaptive-foreground.png"
      },
      "package": "ni.itini.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111F",
          "image": "./assets/brand/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ITINI usa tu ubicación para mostrarte en el mapa y preparar una alerta SOS de demostración."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ITINI necesita acceso a tus fotos para compartir el estado actual de los destinos en Comunidad.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "df6b2d82-6fc3-4db6-a463-b90f50565416"
      }
    }
  }
}
